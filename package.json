{
  "name": "nomad-link",
  "version": "1.0.0",
  "private": true,
  "description": "NOMAD LINK: No Signal. No Limits. Offline-first P2P mesh & convoy coordination platform.",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verify": "node tests/runVerification.cjs && node tests/runSecurityVerification.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testMatch": [
      "**/tests/**/*.test.(ts|tsx|js)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native)/)"
    ]
  }
}
